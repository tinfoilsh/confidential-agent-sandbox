{
  "$schema": "https://opencode.ai/config.json",
  "model": "tinfoil/kimi-k3",
  "small_model": "tinfoil/kimi-k3",
  "enabled_providers": [
    "tinfoil"
  ],
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "tinfoil": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tinfoil through Monitor",
      "options": {
        "baseURL": "https://inference.tinfoil.sh/v1",
        "apiKey": "{env:TINFOIL_API_KEY}"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 256000,
            "output": 65536
          }
        }
      }
    }
  }
}
