#!/bin/bash
set -euo pipefail
umount -ln /.oldroot
# Leave device management with the CVM, while its cgroup submount stays writable.
mount -o remount,bind,ro /sys
if [[ $(stat -c %u /workspace) == 0 ]]; then chown sandbox:sandbox /workspace; fi
# Rebuild the cache after this boot's NVIDIA driver mounts have arrived.
ldconfig
# Docker's nftables backend needs forwarding in each new network namespace.
# Use a runtime drop-in so existing persistent OS installations get it too.
mkdir -p /run/systemd/system/docker.service.d
printf '[Service]\nExecStartPre=/usr/sbin/sysctl -q -w net.ipv4.ip_forward=1\n' > /run/systemd/system/docker.service.d/workspace-forwarding.conf
export container=docker
exec /sbin/init
