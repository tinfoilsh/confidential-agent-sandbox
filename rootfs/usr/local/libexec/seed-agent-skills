#!/bin/bash
# Run as the home directory's owner, after the persistent home has been mounted.
set -euo pipefail

agent_home=${1:-$HOME}
skill_source=${2:-/usr/local/share/monitor/skills/monitor}
[[ -f $skill_source/SKILL.md ]]

for relative in .claude/skills .codex/skills .agents/skills .gemini/skills .config/opencode/skills; do
    destination=$agent_home/$relative/monitor
    # Keep existing user skills and symlinks, including intentionally broken links.
    if [[ ! -e $destination && ! -L $destination ]]; then
        mkdir -p "$agent_home/$relative"
        ln -s "$skill_source" "$destination"
    fi
done
