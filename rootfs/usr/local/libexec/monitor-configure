#!/usr/bin/env python3
"""Write this boot's Monitor files in the directory managed by systemd."""

import ipaddress
import json
import os
from pathlib import Path
import sys


def configure(source, directory):
    boot = source is None
    route = json.loads(os.environ["MONITOR_ROUTE"])
    if not isinstance(route, dict):
        raise ValueError("invalid Monitor enrollment")
    if any(not isinstance(route.get(key), str) for key in ("domain", "ip", "host_key")):
        raise ValueError("missing Monitor enrollment fields")
    ip = ipaddress.ip_address(route["ip"])
    if isinstance(ip, ipaddress.IPv6Address):
        ip = ip.ipv4_mapped
    if (ip is None or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified
            or int(ip) == 0xffffffff or type(route.get("port")) is not int or not 1 <= route["port"] <= 65535
            or not route["domain"] or any(c in route["domain"] for c in "/:@ \r\n")
            or not route["host_key"].startswith(("ssh-", "ecdsa-"))
            or any(c in route["host_key"] for c in "\r\n")
            or "identity" in route):
        raise ValueError("invalid Monitor SSH route")
    # Enrollment supplies only the private agent identity; routing is always measured.
    if not boot:
        identity = source.read_text()
        if "PRIVATE KEY" not in identity:
            raise ValueError("invalid Monitor agent identity")
        (directory / "identity").write_text(identity)
    (directory / "known_hosts").write_text("monitor " + route["host_key"] + "\n")
    (directory / "endpoint.conf").write_text(f"HostName {ip}\nPort {route['port']}\n")
    route["ip"] = str(ip)
    (directory / "route.json").write_text(json.dumps(route))


if __name__ == "__main__":
    try:
        configure(None if sys.argv[1] == "--boot" else Path(sys.argv[1]), Path(os.environ["RUNTIME_DIRECTORY"]))
    except (OSError, ValueError, KeyError) as error:
        sys.exit(f"monitor-configure: {error}")
