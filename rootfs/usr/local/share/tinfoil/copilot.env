# Source in a subshell: (. /usr/local/share/tinfoil/copilot.env; copilot)
export COPILOT_PROVIDER_BASE_URL=https://tinfoil.monitor/v1
export COPILOT_PROVIDER_TYPE=openai
export COPILOT_PROVIDER_WIRE_API=completions
export COPILOT_PROVIDER_BEARER_TOKEN=monitor
# tinfoil-models.service writes the default model and its token limits as plain lines.
{ read -r COPILOT_MODEL; read -r COPILOT_PROVIDER_MAX_PROMPT_TOKENS; read -r COPILOT_PROVIDER_MAX_OUTPUT_TOKENS; } < /usr/local/share/tinfoil/copilot.model
export COPILOT_MODEL COPILOT_PROVIDER_MODEL_ID="$COPILOT_MODEL" COPILOT_PROVIDER_WIRE_MODEL="$COPILOT_MODEL" \
    COPILOT_PROVIDER_MAX_PROMPT_TOKENS COPILOT_PROVIDER_MAX_OUTPUT_TOKENS
