[Unit]
Description=Owner access through Monitor
After=network.target
StartLimitIntervalSec=0

[Service]
ExecCondition=/usr/bin/test -s /run/workspace/monitor-bootstrap.conf
ExecStart=/usr/bin/ssh -NT -F /etc/ssh/monitor-reverse.conf monitor
Restart=always
RestartSec=2s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
